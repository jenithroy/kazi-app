rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRole(role) {
      return isSignedIn() && userDoc().data.role == role;
    }
    function isNepalAdmin() {
      return hasRole("nepal_admin");
    }
    function isNepalStaff() {
      return hasRole("nepal_staff") || isNepalAdmin();
    }
    function isSuperAdmin() {
      return hasRole("super_admin");
    }
    function isUkAdmin() {
      return hasRole("uk_admin");
    }
    function changingOnlyStatus() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(["status"]);
    }
    
    // Dynamic permission check connected to the user doc in Firestore
    function hasPermission(section) {
      return isSignedIn() && (
        userDoc().data.role == "super_admin" ||
        ("permissions" in userDoc().data && (
          userDoc().data.permissions[section] == true ||
          (userDoc().data.permissions[section] != null && userDoc().data.permissions[section] != false)
        ))
      );
    }

    match /{document=**} {
      allow read: if isSignedIn() && request.path[3] != 'bank_transactions';
    }
    match /attendance/{id} {
      // Staff may always write their own attendance row (GPS clock-in/out) —
      // employee-role users have no "attendance" permission but still clock in.
      allow create, update: if hasPermission("attendance") || isNepalStaff() || isSuperAdmin()
        || (isSignedIn()
            && request.resource.data.staffId == request.auth.uid
            && id == request.resource.data.date + "_" + request.auth.uid);
      allow delete: if false;
    }
    match /clock_ins/{id} {
      allow create, update: if isSignedIn();
    }
    match /production/{id} {
      allow create, update: if hasPermission("production") || isNepalStaff() || isSuperAdmin();
      allow delete: if false;
    }
    match /inventory/{id} {
      allow create, update: if hasPermission("inventory") || isNepalStaff() || isSuperAdmin();
      allow delete: if hasPermission("inventory") || isNepalStaff() || isSuperAdmin();
    }
    match /stock_movements/{id} {
      allow create, update, delete: if hasPermission("inventory") || hasPermission("finance") || isNepalStaff() || isSuperAdmin();
    }
    match /qc_logs/{id} {
      allow create, update: if hasPermission("qc") || isNepalStaff() || isSuperAdmin();
      allow delete: if false;
    }
    match /tasks/{id} {
      allow create, update: if hasPermission("tasks") || isNepalStaff() || isUkAdmin() || isSuperAdmin();
      allow delete: if hasPermission("tasks") || isNepalAdmin() || isUkAdmin() || isSuperAdmin();
    }
    match /task_columns/{id} {
      allow create, update, delete: if isNepalAdmin() || isUkAdmin() || isSuperAdmin();
    }
    match /unit_economics/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isNepalStaff() || isUkAdmin() || isSuperAdmin();
    }
    match /fabrics/{id} {
      allow create, update, delete: if hasPermission("library") || isNepalStaff() || isUkAdmin() || isSuperAdmin();
    }
    match /processes/{id} {
      allow create, update, delete: if hasPermission("library") || isNepalStaff() || isUkAdmin() || isSuperAdmin();
    }
    match /patterns/{id} {
      allow create, update, delete: if hasPermission("library") || isNepalStaff() || isUkAdmin() || isSuperAdmin();
    }
    match /samples/{id} {
      allow create, update, delete: if hasPermission("library") || isNepalStaff() || isUkAdmin() || isSuperAdmin();
    }
    match /bank_transactions/{id} {
      allow read: if isNepalAdmin() || isUkAdmin() || isSuperAdmin();
      allow create, update: if isNepalAdmin() || isSuperAdmin();
      allow delete: if isNepalAdmin() || isSuperAdmin();
    }
    match /content/{id} {
      allow create: if hasPermission("budget") || isNepalStaff() || isSuperAdmin();
      allow update: if hasPermission("budget") || isNepalStaff() || isSuperAdmin() || (isUkAdmin() && changingOnlyStatus());
      allow delete: if false;
    }
    match /content_calendar/{id} {
      allow read, create, update, delete: if isSignedIn();
    }
    match /finance_expenses/{id} {
      allow create, update: if hasPermission("finance") || isNepalStaff() || isSuperAdmin();
      allow delete: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
    }
    match /users/{id} {
      allow create: if isSignedIn() && (request.auth.uid == id || isSuperAdmin() || isUkAdmin() || isNepalAdmin() || hasPermission("employees"));
      allow update: if isSignedIn() && (request.auth.uid == id || isSuperAdmin() || isUkAdmin() || isNepalAdmin() || hasPermission("employees"));
      allow delete: if isSignedIn() && (isSuperAdmin() || isUkAdmin() || isNepalAdmin() || hasPermission("employees"));
    }
    match /finance_payroll/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
    }
    match /finance_purchases/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
    }
    match /finance_vat/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /finance_journal/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    // Accounting section — chart of accounts & journal entries (names used by the app)
    match /accounts/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /journal_entries/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /vat_bills/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
    }
    match /order_costs/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /product_costs/{id} {
      allow create, update: if hasPermission("finance") || isNepalAdmin() || isUkAdmin() || isSuperAdmin();
      allow delete: if hasPermission("finance") || isNepalAdmin() || isUkAdmin() || isSuperAdmin();
    }
    // Rewards / leaderboard — written from task completion by any signed-in user
    match /user_points/{id} {
      allow create, update: if isSignedIn();
      allow delete: if false;
    }
    match /point_transactions/{id} {
      allow create, update: if isSignedIn();
      allow delete: if false;
    }
    match /leaderboard/{id} {
      allow create, update: if isSignedIn();
      allow delete: if false;
    }
    match /budget_requests/{id} {
      allow create, update: if isSignedIn();
      allow delete: if hasPermission("budget") || isNepalAdmin() || isSuperAdmin();
    }
    match /orders/{id} {
      allow create, update: if hasPermission("production") || isNepalAdmin() || isSuperAdmin();
      allow delete: if hasPermission("production") || isNepalAdmin() || isSuperAdmin();
    }
    // VAT bills (invoices), challans, and quotations are Nepal IRD-facing documents —
    // sequential numbers must never gain gaps or get reused. Once issued a document
    // can only be Cancelled (status change), never deleted.
    match /invoices/{id} {
      allow create, update: if hasPermission("billing") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /challans/{id} {
      allow create, update: if hasPermission("billing") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /quotations/{id} {
      allow create, update: if hasPermission("billing") || isNepalAdmin() || isSuperAdmin();
      allow delete: if false;
    }
    match /counters/{id} {
      allow create, update: if isSignedIn();
    }
    match /customers/{id} {
      allow create, update, delete: if hasPermission("employees") || isNepalAdmin() || isUkAdmin() || isSuperAdmin();
    }
    match /employees/{id} {
      allow create, update, delete: if hasPermission("employees") || isNepalAdmin() || isUkAdmin() || isSuperAdmin();
    }

    match /stage_config/{doc} {
      allow read: if request.auth != null;
      allow write: if isNepalAdmin() || isSuperAdmin();
    }
    match /order_assignments/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /messages/{doc} {
      allow read, write: if request.auth != null;
    }
  }
}

scratch/

# The owner's own pictures for trying the Embroidery Digitizer: other people's artwork, not ours to publish
sample images/

.dev.vars*
!.dev.vars.example
!.env.example

.gitignore

# Mentions
mentions/

# Instagram DM bot (separate running service, not part of this app's build)
meta-dm-bot/

# Project docs (root level only; README and CONTRIBUTING stay for GitHub)
/*.md
!/README.md
!/CONTRIBUTING.md

# Speech test kit (scripts/transcription-test): private business recordings, the transcripts of them,
# the glossary (it can hold customer and staff names) and its Python environment. Never commit these.
# These rules live here because the rule above ignores any nested .gitignore file.
/scripts/transcription-test/recordings/
/scripts/transcription-test/results/
/scripts/transcription-test/glossary.txt
/scripts/transcription-test/venv/
/scripts/transcription-test/__pycache__/

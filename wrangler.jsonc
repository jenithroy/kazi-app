{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kazi-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}

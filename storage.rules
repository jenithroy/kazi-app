rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Fabric swatch photos and pattern tech packs — readable by anyone with
    // the URL, writable only by signed-in users.
    match /fabrics/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /patterns/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Everything else requires auth for both read and write.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
